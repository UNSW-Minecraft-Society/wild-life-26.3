{
	"schemaVersion": 1,
	"id": "wild-life",
	"version": "${version}",
	"name": "Wild Life",
	"description": "Wild life plugin series inspired by Grians series",
	"authors": [
		"TitanPlayz"
	],
	"contact": {
		"homepage": "https://unsw.minecraft.com/",
		"sources": "https://github.com/UNSW-Minecraft-Society/wild-life-26.3"
	},
	"license": "CC0-1.0",
	"icon": "assets/wild-life/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "mcsoc.wildlife.WildLife",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "mcsoc.wildlife.client.WildLifeClient",
				"adapter": "kotlin"
			}
		],
		"fabric-datagen": [
			{
				"value": "mcsoc.wildlife.client.WildLifeDataGenerator",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"wild-life.mixins.json",
		{
			"config": "wild-life.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}